# systemd-sysupdate transfer: Unified Kernel Image (UKI).
#
# This file is deliberately named alphabetically LAST: sysupdate executes
# transfers in filename order and renames into place in the same order, so
# the boot entry point (the UKI) is only established after the system tree
# it boots is fully in place. An interrupted update can never leave a UKI
# whose backing tree is missing.
#
# The UKI embeds immutable.version=<version> on its kernel command line,
# version-locking it to the system tree updated by 10-system.transfer
# (both transfers share the same @v).

[Transfer]
# See 10-system.transfer for why ProtectVersion is a transition.sh drop-in.

[Source]
Type=url-file
Path=https://immutable-ubuntu.example.com/noble/
MatchPattern=ubuntu_@v.efi

[Target]
Type=regular-file
# Absolute path with the anchor: sysupdate rejects a relative Target path
# ("Target path is not a normalized, absolute path: EFI/Linux") even with
# PathRelativeTo set. This is the form the sysupdate.d man page itself uses
# (Path=/EFI/Linux with an anchor); it still resolves under the ESP.
Path=/EFI/Linux
PathRelativeTo=esp
MatchPattern=ubuntu_@v.efi
# No CurrentSymlink: the ESP is vfat, and vfat has no symlinks, so
# sysupdate fails the whole update with "Operation not permitted" when it
# tries to update one. systemd-boot auto-discovers UKIs in EFI/Linux, and
# transition.sh sets the default to the ubuntu_*.efi glob, which selects
# the newest UKI by version sorting — no stable name needed, and timer
# updates stay purely sysupdate.
InstancesMax=2
Mode=0644
