#!/bin/sh
# initramfs-tools hook: make sure mount(8) is available in the initrd for
# the immutable-usr local-premount script. (Busybox usually provides it;
# this is belt and suspenders when util-linux mount exists.)
set -e

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
    prereqs) prereqs; exit 0;;
esac

. /usr/share/initramfs-tools/hook-functions

if [ -x /bin/mount ]; then
    copy_exec /bin/mount /bin/mount
fi
